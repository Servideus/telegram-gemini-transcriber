# Create your own bot with @BotFather and your own Gemini API key.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Leave empty for setup: /start will show your private chat ID.
# Set that ID here and restart to enable transcription.
TELEGRAM_CHAT_ID=

# Tried once each, in this order, after any error or empty response.
GEMINI_MODELS=gemini-3.5-transcribe,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-flash-lite-latest
REQUEST_TIMEOUT=420
MAX_FILE_SIZE_MB=50
FFMPEG_EXE=ffmpeg

# Optional local Telegram Bot API (cloud download limit: 20 MB).
TELEGRAM_LOCAL_MODE=0
TELEGRAM_BASE_URL=
TELEGRAM_BASE_FILE_URL=
